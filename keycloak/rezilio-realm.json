{
  "id": "rezilio",
  "realm": "rezilio",
  "displayName": "Rezilio",
  "displayNameHtml": "<strong>Rezilio</strong>",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "Admin",        "description": "Teljes hozzáférés minden modulhoz" },
      { "name": "RiskManager",  "description": "Kockázatok kezelése" },
      { "name": "RiskOwner",    "description": "Kockázati tulajdonos" },
      { "name": "Auditor",      "description": "Csak olvasási hozzáférés" },
      { "name": "Executive",    "description": "Vezető: összesített nézet" },
      { "name": "Viewer",       "description": "Korlátozott olvasói hozzáférés" }
    ]
  },
  "clients": [
    {
      "clientId": "rezilio-api",
      "name": "Rezilio API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "app-user-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "app:user_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "app-tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "app:tenant_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "app-email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "app:email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "app-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "false",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "app:roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "rezilio-frontend",
      "name": "Rezilio Frontend",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3001/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:3001"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "rezilio-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "rezilio-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dev-admin",
      "email": "dev-admin@rezilio.local",
      "firstName": "Dev",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["00000000-0000-0000-0000-000000000001"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["Admin"]
    },
    {
      "username": "dev-riskmanager",
      "email": "dev-riskmanager@rezilio.local",
      "firstName": "Dev",
      "lastName": "RiskManager",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["00000000-0000-0000-0000-000000000001"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "risk123",
          "temporary": false
        }
      ],
      "realmRoles": ["RiskManager"]
    }
  ]
}
